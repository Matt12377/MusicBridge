# POC-001 should run on the same Mac as Roon Server/Core.
BRIDGE_CONTROL_HOST=127.0.0.1
BRIDGE_CONTROL_PORT=38501
BRIDGE_STREAM_HOST=127.0.0.1
BRIDGE_STREAM_PORT=38502
BRIDGE_PUBLIC_STREAM_BASE_URL=http://127.0.0.1:38502

# Use a current cookie from YOUR OWN NetEase Cloud Music account.
# Never paste this into chat, commit it, or include it in logs/screenshots.
NETEASE_COOKIE=""
NETEASE_DEFAULT_QUALITY=lossless

# Hard safety rails. The program refuses to start if any is enabled.
ENABLE_GENERAL_UNBLOCK=false
ENABLE_PROXY=false
ENABLE_RANDOM_CN_IP=false

LOG_LEVEL=info
